#!/bin/sh
# Starts Cut Content Anything straight from this checkout, without installing it.
# Usage: bin/cutcontent doctor | scan <path> | gui
# The script may be linked into a folder on your PATH (e.g. ~/.local/bin/cutcontent);
# links are followed so the checkout is still found.
script_path="$0"
while [ -L "$script_path" ]; do
    link_target="$(readlink "$script_path")"
    case "$link_target" in
        /*) script_path="$link_target" ;;
        *) script_path="$(dirname "$script_path")/$link_target" ;;
    esac
done
checkout_directory="$(cd "$(dirname "$script_path")/.." && pwd)"
PYTHONPATH="$checkout_directory${PYTHONPATH:+:$PYTHONPATH}" PYTHONUTF8=1 exec python3 -m cutcontent "$@"
